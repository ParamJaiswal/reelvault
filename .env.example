# ReelVault configuration (all optional — sane defaults for this machine)
# RV_MODELS_DIR=D:/reel-knowledge/models
# RV_MEDIA_DIR=D:/reel-knowledge/media
# RV_DB_PATH=C:/Users/dell/reel-knowledge/data/reelvault.db
# RV_LLM_SERVER_URL=http://127.0.0.1:8091/v1
# RV_WHISPER_MODEL_SIZE=small        # tiny|base|small (8GB RAM -> small ok, base safer)
# RV_WHISPER_BACKEND=auto            # auto|torch (auto = faster-whisper then torch fallback)
# RV_WHISPER_DEVICE=cuda
# RV_AUTH_TOKEN=                     # empty = auto-generate into data/.auth_token
# RV_RETENTION_MEDIA_DAYS=30         # 0 = keep forever

# --- v2 cloud LLM (Groq free tier verified seam; any OpenAI-compatible works) ---
# Add to .env (gitignored) — never commit the key itself:
# RV_LLM_BACKEND=openai_compat        # default stays llamacpp (v0.1 behavior)
# RV_LLM_API_KEY=gsk_...              # read via settings.llm_api_key only
# RV_LLM_SERVER_URL=https://api.groq.com/openai/v1
# RV_LLM_MODEL_NAME=llama-3.3-70b-versatile
